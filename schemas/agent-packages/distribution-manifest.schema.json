{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chaz-clark/canvas-toolbox/schemas/agent-packages/distribution-manifest.schema.json",
  "title": "Canvas Toolbox Distribution Manifest",
  "description": "Exact, schema-validated roots from which the course-facing payload is resolved.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "packages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "kind": {
            "enum": ["file", "tree"]
          },
          "install": {
            "enum": ["copy", "merge", "generate"]
          }
        },
        "required": ["path", "kind", "install"]
      }
    }
  },
  "required": ["schema_version", "version", "packages", "entries"],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
